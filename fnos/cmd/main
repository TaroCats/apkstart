#!/bin/sh
# =============================================================================
# ApkStart 服务生命周期（ARCH §6.1 / §10-2 / §10-3）
#   start  : 解析 node → 后台启动 server/index.js → 轮询 /api/health 200（最多 20s）→ exit 0
#   stop   : SIGTERM → 等待 → SIGKILL；并 adb emu kill + 清理模拟器残留
#   status : 运行中 exit 0，未运行 exit 3
# 幂等：已运行且健康 → 直接 exit 0；已运行但不健康 → 清理后重启。
# 数据根：TRIM_PKGVAR（次选 TRIM_APPDATA，本地回退 $HOME/.apkstart）。
# =============================================================================
set -u

# ---------- 路径解析 ----------
APPDEST="${TRIM_APPDEST:-}"
DATA_ROOT="${TRIM_PKGVAR:-${TRIM_APPDATA:-$HOME/.apkstart}}"
LOG_DIR="$DATA_ROOT/logs"
PID_FILE="$DATA_ROOT/service.pid"
LOG_FILE="$LOG_DIR/service.log"
PORT="${TRIM_SERVICE_PORT:-}"
DEFAULT_PORT=18990
HEALTH_TIMEOUT=20   # 秒
HEALTH_INTERVAL=1

mkdir -p "$LOG_DIR"

log() {
  msg="[$(date '+%Y-%m-%dT%H:%M:%S%z')] $*"
  echo "$msg" >> "$LOG_FILE" 2>/dev/null || true
  [ -n "${TRIM_TEMP_LOGFILE:-}" ] && echo "$msg" >> "$TRIM_TEMP_LOGFILE" 2>/dev/null || true
}

# ---------- Node 运行时解析（ARCH §5.0） ----------
resolve_node() {
  for c in "${NODE_BIN:-}" /usr/local/bin/node "$(command -v node 2>/dev/null)" /var/apps/nodejs*/target/bin/node; do
    [ -n "$c" ] && [ -x "$c" ] && { echo "$c"; return 0; }
  done
  echo '未找到 Node.js 运行时。请在飞牛应用中心安装官方「Node.js」应用，或设置 NODE_BIN 环境变量。' >&2
  return 1
}

# ---------- 进程存活 ----------
pid_alive() {
  pid="$1"
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

read_pid() {
  [ -f "$PID_FILE" ] && cat "$PID_FILE" 2>/dev/null | tr -d '[:space:]'
}

# ---------- 端口解析与占用探测（IMPL 偏差 15） ----------
# 为什么不再写死一个数：目标机上 8890 被 Docker 里的 uvicorn（`uvicorn app.main:app
# --port 8890`，root）长期占用，我们 bind 不上，进程秒退，安装器只能看到「启动失败 +
# 日志尾部」这种二手信息。端口必须是可解释、可探测、可改的：
#   ① 优先 TRIM_SERVICE_PORT（平台注入时听平台的）
#   ② 其次读 ui/config 的 "port" —— 那是桌面图标点击时用的端口，服务跟着它走，
#      两者不会出现「图标指 A、服务听 B」的漂移（虽然 pack.sh 用同一个 $PORT 注入，
#      但人工改 ui/config 或平台改写时这条兜底就有用）
#   ③ 最后回落 DEFAULT_PORT
# 用 sed 而不是 node 解析：这一步发生在 resolve_node 之前，不能假设 node 可用。
port_from_uiconfig() {
  f="$APPDEST/ui/config"
  [ -f "$f" ] || return 1
  p="$(sed -n 's/.*"port"[[:space:]]*:[[:space:]]*"\([0-9][0-9]*\)".*/\1/p' "$f" 2>/dev/null | head -n1)"
  [ -n "$p" ] || return 1
  echo "$p"
}

resolve_port() {
  if [ -n "${PORT:-}" ]; then echo "$PORT"; return 0; fi
  if p="$(port_from_uiconfig)"; then echo "$p"; return 0; fi
  echo "$DEFAULT_PORT"
}

# 端口是否已被**别的进程**监听。只判「有人在听」，不判对方是谁：
# 走到这里时自己的 pidfile 已被判过（幂等分支在上面），所以命中就是外部占用。
port_busy() {
  p="$1"
  [ -n "$p" ] || return 1
  if command -v ss >/dev/null 2>&1; then
    ss -ltn "sport = :$p" 2>/dev/null | grep -q LISTEN
  elif command -v netstat >/dev/null 2>&1; then
    # 注意别写成 netstat -ltn：macOS/BSD 的 netstat 不认 -l（照样列出 ESTABLISHED），
    # 结果永远匹配不到 LISTEN（本地跑测试时就是这么发现写错了）。用 -an 再筛 LISTEN，
    # 两种实现的地址分隔符不同（Linux `0.0.0.0:PORT`、BSD `127.0.0.1.PORT`），故用 [:.]。
    netstat -an 2>/dev/null | grep -E "[:.]$p[[:space:]]" | grep -q LISTEN
  else
    return 1   # 没有探测工具时不拦，交给 bind 自己失败
  fi
}

# 尽力回显占用者。非 root 跑时 ss -p 拿不到别人的进程信息，属正常，回显空。
port_holder() {
  p="$1"
  ss -ltnp "sport = :$p" 2>/dev/null | sed -n '2,$p' | grep -o 'users:(.*)' | head -n1
}

# ---------- 健康检查（用 node 自身，避免依赖 curl） ----------
# 只看状态码是不够的：默认端口 8890 在目标机上曾被第三方服务（uvicorn）占用，它的
# /api/health 同样返回 200，导致「别人的服务」被当成自己启动成功（假成功）。端口虽然
# 已在 0.2.3 换到 18990，这个「校验响应体而非状态码」的判据仍然必须保留——任何端口
# 都可能被别人占，而 200 从来不等于「是我的服务」。因此必须校验响应体：
#   ① statusCode === 200
#   ② body.app === 'apkstart-fnos'
#   ③ body.pid 存在且 等于 $PID_FILE 中的 pid（防止上一次残留实例被误认）
health_ok() {
  [ -n "${NODE:-}" ] || return 1
  HK_PORT="$PORT" HK_SOCK="${LISTEN_SOCKET:-}" HK_PID="$(read_pid)" "$NODE" -e '
    const http = require("http");
    const wantPid = Number(process.env.HK_PID) || 0;
    const opts = process.env.HK_SOCK
      ? { socketPath: process.env.HK_SOCK, path: "/api/health", timeout: 1500 }
      : { host: "127.0.0.1", port: Number(process.env.HK_PORT) || 18990, path: "/api/health", timeout: 1500 };
    const req = http.get(opts, (res) => {
      if (res.statusCode !== 200) { res.resume(); return process.exit(1); }
      let body = "";
      res.setEncoding("utf8");
      res.on("data", (c) => {
        body += c;
        if (body.length > 65536) { req.destroy(); process.exit(1); }
      });
      res.on("end", () => {
        let info;
        try { info = JSON.parse(body); } catch (_) { return process.exit(1); }
        if (!info || info.app !== "apkstart-fnos") return process.exit(1);
        if (!info.pid || Number(info.pid) !== wantPid) return process.exit(1);
        process.exit(0);
      });
    });
    req.on("error", () => process.exit(1));
    req.on("timeout", () => { req.destroy(); process.exit(1); });
  ' >/dev/null 2>&1
}

# ---------- 停止实现 ----------
do_stop() {
  pid="$(read_pid)"
  if pid_alive "$pid"; then
    log "停止服务 pid=$pid (SIGTERM)"
    kill -TERM "$pid" 2>/dev/null || true
    i=0
    while pid_alive "$pid" && [ "$i" -lt 15 ]; do
      sleep 1; i=$((i + 1))
    done
    if pid_alive "$pid"; then
      log "SIGTERM 超时，强制 SIGKILL pid=$pid"
      kill -KILL "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "$PID_FILE" 2>/dev/null || true

  # 关闭模拟器：优先经 adb，兜底直接杀进程
  # serial 用 adb server 内的设备名 emulator-5554（不是 127.0.0.1:5554：
  # 5554 是 console 端口，adb 走 5555，写 IP:5554 会永远 not found —— 真机实测）
  # adb 在**数据根**的 runtime/ 下，不在代码根：运行时组件由服务自己下载到
  # TRIM_PKGVAR/runtime（见 server/service/paths.js 的 RUNTIME）。
  # 旧实现写成 $APPDEST/runtime/...，永远 -x 失败，只靠后面的 pkill 兜底（假成功）。
  ADB_BIN="$DATA_ROOT/runtime/platform-tools/adb"
  if [ -x "$ADB_BIN" ]; then
    ANDROID_ADB_SERVER_PORT="${ANDROID_ADB_SERVER_PORT:-5044}" "$ADB_BIN" -s "emulator-5554" emu kill 2>/dev/null || true
  fi
  pkill -f "${DATA_ROOT}/runtime/emulator/emulator" 2>/dev/null || true
  pkill -f "qemu-system-x86_64.*${DATA_ROOT}" 2>/dev/null || true
  return 0
}

# ---------- 启动实现 ----------
do_start() {
  NODE="$(resolve_node)" || { log "resolve_node 失败"; return 1; }
  export NODE

  # 端口必须在健康检查之前定下来：health_ok 用它发请求
  PORT="$(resolve_port)"
  export PORT

  # 幂等：已运行
  pid="$(read_pid)"
  if pid_alive "$pid"; then
    if health_ok; then
      log "已在运行且健康 pid=${pid}，直接返回"
      return 0
    fi
    log "进程存活但健康检查失败 pid=${pid}，清理后重启"
    do_stop
  fi

  SERVER_JS="${APPDEST}/server/index.js"
  if [ ! -f "$SERVER_JS" ]; then
    log "未找到服务入口: $SERVER_JS"
    echo "未找到服务入口: $SERVER_JS" >&2
    return 1
  fi

  # 启动前探测端口：与其让 node 抛 EADDRINUSE 秒退、再让安装器回显日志尾部，
  # 不如在这里就说清「谁占了、怎么办」。
  # 走 unix socket 时（P1 网关方案）没有端口可占，跳过探测
  if [ -z "${LISTEN_SOCKET:-}" ] && port_busy "$PORT"; then
    holder="$(port_holder "$PORT")"
    log "端口 ${PORT} 已被占用，拒绝启动（占用者: ${holder:-未知}）"
    {
      echo "ApkStart 无法启动：端口 ${PORT} 已被其他程序占用${holder:+，占用者 $holder}。"
      echo "  图标指向的端口来自 ${APPDEST}/ui/config，改这里的 \"port\" 即可换端口"
      echo "  （改成空闲端口后重新启动本服务）；也可以让占用该端口的程序换端口。"
      echo "  当前监听情况："
      ss -ltn "sport = :$PORT" 2>/dev/null | sed -n '1,3p' || true
    } >&2
    return 1
  fi

  log "启动 node=$NODE server=$SERVER_JS port=$PORT"
  # 传关键 TRIM_* 给子进程；nohup 脱离会话
  TRIM_PKGVAR="$DATA_ROOT" TRIM_APPDEST="$APPDEST" TRIM_SERVICE_PORT="$PORT" \
    nohup "$NODE" "$SERVER_JS" >> "$LOG_FILE" 2>&1 &
  newpid=$!
  echo "$newpid" > "$PID_FILE"
  log "已拉起源码进程 pid=${newpid}，等待健康检查（最多 ${HEALTH_TIMEOUT}s）"

  i=0
  while [ "$i" -lt "$HEALTH_TIMEOUT" ]; do
    if health_ok; then
      log "健康检查通过，启动成功 pid=$newpid"
      return 0
    fi
    if ! pid_alive "$newpid"; then
      # 进程已退出：通常是端口被占用 / 代码异常。立即失败并回显日志尾部，
      # 让调用方（fnOS 安装器 / 运维）第一屏就能看到真正原因。
      log "进程已退出，启动失败（健康检查未通过）"
      wait "$newpid" 2>/dev/null || true   # 回收子进程，避免 "Killed: 9" 噪声
      rm -f "$PID_FILE" 2>/dev/null || true
      {
        echo "ApkStart 启动失败：服务进程已退出，健康检查未通过。下面是日志尾部（${LOG_FILE}）："
        tail -n 20 "$LOG_FILE" 1>&2 2>/dev/null || true
      } >&2
      return 1
    fi
    sleep "$HEALTH_INTERVAL"
    i=$((i + 1))
  done

  log "健康检查在 ${HEALTH_TIMEOUT}s 内未通过，终止并清理"
  kill -KILL "$newpid" 2>/dev/null || true
  wait "$newpid" 2>/dev/null || true   # 回收子进程，避免 shell 打印 "Killed: 9" 噪声
  rm -f "$PID_FILE" 2>/dev/null || true
  {
    echo "服务启动后健康检查未通过（${HEALTH_TIMEOUT}s），请查看日志: ${LOG_FILE}"
    tail -n 20 "$LOG_FILE" 1>&2 2>/dev/null || true
  } >&2
  return 1
}

# ---------- 分发 ----------
CMD="${1:-}"
case "$CMD" in
  start)  do_start; exit $? ;;
  stop)   do_stop;  exit 0 ;;
  status)
    NODE="$(resolve_node 2>/dev/null || true)"
    export NODE
    pid="$(read_pid)"
    if pid_alive "$pid"; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "用法: $0 {start|stop|status}" >&2
    exit 1
    ;;
esac
