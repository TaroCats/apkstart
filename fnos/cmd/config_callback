#!/bin/sh
# =============================================================================
# 配置变更后处理（fnOS 生命周期脚本）
#
# P0 无平台配置项（详见同目录 config_init 的说明）：全部参数由自带 Web 控制台
# 的 /api/settings 管理。本脚本实现为**幂等空操作**，仅为满足 fnOS 生命周期契约。
#
# P1 接入平台配置项时，在此实现「落盘配置 → 重启服务生效」（可复用
# cmd/upgrade_callback 的 start + 健康轮询逻辑）。
# 必须以 0 退出，否则平台侧配置变更会被判为失败。
# =============================================================================
set -u

exit 0
